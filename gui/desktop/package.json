{
  "name": "auto-attendance-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "AAS GUI（Electron + React + TS）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "cross-env AAS_DEV=1 electron .",
    "start": "npm run build && electron .",
    "predist:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-running-client.ps1",
    "dist:exe": "npm run build && electron-builder --win --x64",
    "predist:dir": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-running-client.ps1",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@types/react-window": "^1.8.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
